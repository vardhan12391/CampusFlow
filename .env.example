# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file to GitHub.

# Port the Express server listens on
PORT=3000

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/campusflow
# Atlas:      mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/campusflow
MONGODB_URI=mongodb://127.0.0.1:27017/campusflow

# Secret used to sign the session cookie.
# Use a long random string in production.
SESSION_SECRET=change_me_to_a_long_random_string

# Hours after which an unresolved High/Urgent complaint is escalated
ESCALATION_HOURS=48

# development | production
NODE_ENV=development
