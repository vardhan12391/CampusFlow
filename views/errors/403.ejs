<%- include('../partials/head') %>

<main class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="display-1 text-danger">403</div>
      <h1 class="h3 fw-bold">Access denied</h1>
      <p class="text-muted">
        You are logged in, but your role is not allowed to open this page.
        <% if (typeof message !== 'undefined' && message) { %>
          <br><span class="badge bg-light text-dark border"><%= message %></span>
        <% } %>
      </p>
      <a href="/" class="btn btn-primary"><i class="bi bi-house me-1"></i>Back to home</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
