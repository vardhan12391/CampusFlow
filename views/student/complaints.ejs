<%- include('../partials/head') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/sidebar', { sidebarSection: 'complaints' }) %>
    </div>

    <div class="col-lg-10 col-md-9">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
              <li class="breadcrumb-item"><a href="/student">Dashboard</a></li>
              <li class="breadcrumb-item active">My Complaints</li>
            </ol>
          </nav>
          <h1 class="h4 fw-bold mb-0">My Complaints</h1>
        </div>
        <span class="text-muted small"><%= totalItems %> complaint(s) found</span>
      </div>

      <%- include('../partials/complaintFilters', { filterAction: '/student/complaints', showLocation: false, showAssigneeFilter: false }) %>

      <div class="card border-0 shadow-sm">
        <%- include('../partials/complaintTable', { showReporter: false, showAssignForm: false }) %>
      </div>

      <%- include('../partials/pagination') %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
