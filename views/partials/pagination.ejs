<%#
 * partials/pagination.ejs
 * Server-side pagination controls.
 * Expected locals: page, totalPages, paginationPages
 * pageUrl(pageNumber) is built by middleware/context.js and keeps every
 * active filter, e.g. /admin/complaints?status=Assigned&page=3
%>
<% if (totalPages > 1) { %>
  <nav aria-label="Complaint list pages" class="mt-3">
    <ul class="pagination pagination-sm justify-content-center mb-0">
      <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="<%= pageUrl(page - 1) %>">Previous</a>
      </li>

      <% paginationPages.forEach(function (entry) { %>
        <% if (entry === '...') { %>
          <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
        <% } else { %>
          <li class="page-item <%= entry === page ? 'active' : '' %>">
            <a class="page-link" href="<%= pageUrl(entry) %>"><%= entry %></a>
          </li>
        <% } %>
      <% }) %>

      <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="<%= pageUrl(page + 1) %>">Next</a>
      </li>
    </ul>
  </nav>
<% } %>
