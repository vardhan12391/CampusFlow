<%#
 * partials/complaintTable.ejs
 * The complaint list table shared by student / staff / admin pages.
 * Expected local: complaints. Optional: showReporter, showAssignForm, staffMembers
%>
<%
  // Names differ from the incoming locals on purpose - re-declaring them
  // with const would throw a "temporal dead zone" error.
  const showReporterCol = typeof showReporter !== 'undefined' ? showReporter : false;
  const showAssignCol = typeof showAssignForm !== 'undefined' ? showAssignForm : false;
  const availableStaff = typeof staffMembers !== 'undefined' ? staffMembers : [];
%>
<% if (complaints.length === 0) { %>
  <div class="text-center text-muted py-5">
    <i class="bi bi-inbox fs-1"></i>
    <p class="mb-0 mt-2">No complaints match your search.</p>
  </div>
<% } else { %>
<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th>Ticket</th>
        <th>Title</th>
        <th>Category</th>
        <th>Location</th>
        <th>Priority</th>
        <th>Status</th>
        <% if (showReporterCol) { %><th>Reported by</th><% } %>
        <th>Assigned to</th>
        <th>Created</th>
        <%# The title cell is already the link to the detail page, so the
            Action column only exists when the inline assign form does. %>
        <% if (showAssignCol) { %><th class="text-end">Action</th><% } %>
      </tr>
    </thead>
    <tbody>
      <% complaints.forEach(function (complaint) { %>
        <tr>
          <td class="text-nowrap">
            <span class="fw-semibold text-primary"><%= complaint.ticketId %></span>
            <% if (complaint.isEscalated) { %>
              <i class="bi bi-exclamation-octagon-fill text-danger ms-1" title="Escalated - not resolved in time"></i>
            <% } %>
          </td>
          <td>
            <a href="/complaints/<%= complaint.ticketId %>" class="text-decoration-none fw-semibold">
              <%= complaint.title %>
            </a>
          </td>
          <td class="text-nowrap"><%= complaint.category %></td>
          <td><%= complaint.location %></td>
          <td><%- include('badges', { badgeType: 'priority', value: complaint.priority }) %></td>
          <td><%- include('badges', { badgeType: 'status', value: complaint.status }) %></td>
          <% if (showReporterCol) { %>
            <td class="text-nowrap"><%= complaint.reportedBy ? complaint.reportedBy.name : '-' %></td>
          <% } %>
          <td class="text-nowrap">
            <% if (complaint.assignedTo) { %>
              <%= complaint.assignedTo.name %>
            <% } else { %>
              <span class="text-muted">Unassigned</span>
            <% } %>
          </td>
          <td class="text-nowrap small"><%= formatDay(complaint.createdAt) %></td>
          <% if (showAssignCol) { %>
            <td class="text-end text-nowrap">
              <% if (availableStaff.length > 0) { %>
                <form action="/complaints/<%= complaint._id %>/assign" method="POST" class="d-inline-flex gap-1">
                  <input type="hidden" name="_method" value="PATCH">
                  <input type="hidden" name="redirect" value="<%= currentPath %>">
                  <select name="assignedTo" class="form-select form-select-sm" style="width: 9rem" aria-label="Assign to">
                    <option value="">Assign to...</option>
                    <% availableStaff.forEach(function (staffMember) { %>
                      <option value="<%= staffMember._id %>"><%= staffMember.name %></option>
                    <% }) %>
                  </select>
                  <button class="btn btn-sm btn-outline-primary" type="submit">Assign</button>
                </form>
              <% } %>
            </td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
