<%#
 * partials/navbar.ejs
 * One responsive navbar shared by every page. The links change based on
 * `currentUser` (set by middleware/auth.js) so each role sees its own menu.
 */
%>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm sticky-top">
  <div class="container-fluid px-3">
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-diagram-3-fill me-1"></i>CampusFlow
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNavbar">
      <% if (currentUser) { %>
        <%#
          Section navigation lives ONLY in partials/sidebar.ejs. Showing the
          same links here as well put two identical menus side by side on
          every dashboard page. The navbar keeps brand + user menu; pages
          without a sidebar (form/detail/analytics) navigate by breadcrumb.
        %>
        <ul class="navbar-nav align-items-lg-center ms-auto">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle me-1"></i><%= currentUser.name %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><span class="dropdown-item-text small text-muted">
                <%= currentUser.email %>
              </span></li>
              <li><span class="dropdown-item-text">
                <span class="badge bg-<%= currentUser.role === 'admin' ? 'danger' : currentUser.role === 'staff' ? 'info text-dark' : 'success' %> text-capitalize">
                  <%= currentUser.role %>
                </span>
              </span></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/auth/logout" method="POST">
                  <button class="dropdown-item" type="submit">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                  </button>
                </form>
              </li>
            </ul>
          </li>
        </ul>
      <% } else { %>
        <ul class="navbar-nav ms-auto">
          <% if (typeof title === 'undefined' || title !== 'Login') { %>
            <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
          <% } %>
          <% if (typeof title === 'undefined' || title !== 'Create account') { %>
            <li class="nav-item"><a class="nav-link" href="/auth/register">Register</a></li>
          <% } %>
        </ul>
      <% } %>
    </div>
  </div>
</nav>
