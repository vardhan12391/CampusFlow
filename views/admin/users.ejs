<%- include('../partials/head') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/sidebar', { sidebarSection: 'users' }) %>
    </div>

    <div class="col-lg-10 col-md-9">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
              <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
              <li class="breadcrumb-item active">User Management</li>
            </ol>
          </nav>
          <h1 class="h4 fw-bold mb-0">User Management</h1>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
          <i class="bi bi-person-plus me-1"></i>Add user
        </button>
      </div>

      <!-- role filter tabs -->
      <ul class="nav nav-pills mb-3 flex-wrap gap-1">
        <li class="nav-item">
          <a class="nav-link py-1 px-3 <%= selectedRole === '' ? 'active' : 'border' %>" href="/admin/users">All (<%= counts.all || 0 %>)</a>
        </li>
        <li class="nav-item">
          <a class="nav-link py-1 px-3 <%= selectedRole === 'student' ? 'active' : 'border' %>" href="/admin/users?role=student">Students (<%= counts.student || 0 %>)</a>
        </li>
        <li class="nav-item">
          <a class="nav-link py-1 px-3 <%= selectedRole === 'staff' ? 'active' : 'border' %>" href="/admin/users?role=staff">Staff (<%= counts.staff || 0 %>)</a>
        </li>
        <li class="nav-item">
          <a class="nav-link py-1 px-3 <%= selectedRole === 'admin' ? 'active' : 'border' %>" href="/admin/users?role=admin">Admins (<%= counts.admin || 0 %>)</a>
        </li>
      </ul>

      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Department</th>
                <th>Details</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% usersList.forEach(function (user) { %>
                <tr>
                  <td class="fw-semibold"><%= user.name %></td>
                  <td class="small"><%= user.email %></td>
                  <td>
                    <span class="badge <%= user.role === 'admin' ? 'bg-danger' : user.role === 'staff' ? 'bg-info text-dark' : 'bg-success' %> text-capitalize">
                      <%= user.role %>
                    </span>
                  </td>
                  <td class="small"><%= user.department || '-' %></td>
                  <td class="small text-muted">
                    <% if (user.role === 'student') { %>
                      <%= user.studentId || '-' %> &middot; <%= user.year ? user.year + ' year' : '' %>
                    <% } else { %>
                      <%= user.jobTitle || '-' %>
                    <% } %>
                  </td>
                  <td>
                    <% if (user.isActive) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Inactive</span>
                    <% } %>
                  </td>
                  <td class="text-end text-nowrap">
                    <% if (user._id.toString() !== currentUser._id.toString()) { %>
                      <!-- change role: a PATCH request hidden inside a POST form -->
                      <form action="/admin/users/<%= user._id %>/role" method="POST" class="d-inline-flex gap-1">
                        <input type="hidden" name="_method" value="PATCH">
                        <select name="role" class="form-select form-select-sm" style="width: 7.5rem" aria-label="New role">
                          <option value="student" <%= user.role === 'student' ? 'selected' : '' %>>Student</option>
                          <option value="staff" <%= user.role === 'staff' ? 'selected' : '' %>>Staff</option>
                          <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                        </select>
                        <button class="btn btn-sm btn-outline-primary" type="submit">Set</button>
                      </form>

                      <form action="/admin/users/<%= user._id %>/status" method="POST" class="d-inline">
                        <input type="hidden" name="_method" value="PATCH">
                        <button class="btn btn-sm <%= user.isActive ? 'btn-outline-danger' : 'btn-outline-success' %>" type="submit">
                          <%= user.isActive ? 'Deactivate' : 'Activate' %>
                        </button>
                      </form>
                    <% } else { %>
                      <span class="badge bg-light text-muted border">that's you</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Modal: create a new account (staff / admin / extra student) -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" action="/admin/users" method="POST">
      <div class="modal-header">
        <h2 class="modal-title h5" id="createUserModalLabel">Add a user</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="userRole">Role</label>
          <select class="form-select" id="userRole" name="role" required>
            <option value="staff" <%= (old && old.role === 'staff') ? 'selected' : '' %>>Staff member</option>
            <option value="admin" <%= (old && old.role === 'admin') ? 'selected' : '' %>>Admin</option>
            <option value="student" <%= (old && old.role === 'student') ? 'selected' : '' %>>Student</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label" for="userName">Full name</label>
          <input type="text" class="form-control <%= fieldError('name') ? 'is-invalid' : '' %>"
                 id="userName" name="name" required minlength="2"
                 value="<%= (old && old.name) ? old.name : '' %>">
          <% if (fieldError('name')) { %><div class="invalid-feedback"><%= fieldError('name') %></div><% } %>
        </div>

        <div class="mb-3">
          <label class="form-label" for="userEmail">Email</label>
          <input type="email" class="form-control <%= fieldError('email') ? 'is-invalid' : '' %>"
                 id="userEmail" name="email" required
                 value="<%= (old && old.email) ? old.email : '' %>">
          <% if (fieldError('email')) { %><div class="invalid-feedback"><%= fieldError('email') %></div><% } %>
        </div>

        <div class="mb-3">
          <label class="form-label" for="userPassword">Password</label>
          <input type="password" class="form-control <%= fieldError('password') ? 'is-invalid' : '' %>"
                 id="userPassword" name="password" required minlength="6">
          <% if (fieldError('password')) { %><div class="invalid-feedback"><%= fieldError('password') %></div><% } %>
        </div>

        <div class="mb-3">
          <label class="form-label" for="userDepartment">Department</label>
          <input type="text" class="form-control <%= fieldError('department') ? 'is-invalid' : '' %>"
                 id="userDepartment" name="department" required
                 value="<%= (old && old.department) ? old.department : '' %>"
                 placeholder="e.g. Electrical / Computer Science">
          <% if (fieldError('department')) { %><div class="invalid-feedback"><%= fieldError('department') %></div><% } %>
        </div>

        <div class="row g-2">
          <div class="col-6">
            <label class="form-label" for="userJobTitle">Job title (staff)</label>
            <input type="text" class="form-control" id="userJobTitle" name="jobTitle"
                   value="<%= (old && old.jobTitle) ? old.jobTitle : '' %>" placeholder="Electrician">
          </div>
          <div class="col-6">
            <label class="form-label" for="userStudentId">Student ID</label>
            <input type="text" class="form-control" id="userStudentId" name="studentId"
                   value="<%= (old && old.studentId) ? old.studentId : '' %>" placeholder="21CS1042">
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create account</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
