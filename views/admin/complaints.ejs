<%- include('../partials/head') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/sidebar', { sidebarSection: query.escalated ? 'escalated' : 'complaints' }) %>
    </div>

    <div class="col-lg-10 col-md-9">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
              <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
              <li class="breadcrumb-item active">All Complaints</li>
            </ol>
          </nav>
          <h1 class="h4 fw-bold mb-0">All Complaints</h1>
        </div>
        <span class="text-muted small"><%= totalItems %> complaint(s) found</span>
      </div>

      <% if (query.escalated) { %>
        <div class="alert alert-danger py-2">
          <i class="bi bi-exclamation-octagon-fill me-1"></i>Showing escalated complaints only.
          <a href="/admin/complaints" class="alert-link">Show all</a>
        </div>
      <% } %>

      <%- include('../partials/complaintFilters', {
        filterAction: '/admin/complaints',
        showLocation: true,
        showAssigneeFilter: true,
        staffMembers: staffMembers
      }) %>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <strong>Use the row to quickly assign a staff member, or open the ticket for status &amp; priority changes.</strong>
        </div>
        <%- include('../partials/complaintTable', {
          showReporter: true,
          showAssignForm: true,
          staffMembers: staffMembers
        }) %>
      </div>

      <%- include('../partials/pagination') %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
